<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Abertura (Android 12+): o símbolo sobre a tinta da marca. -->
    <style name="Tema" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo_claro</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/tinta</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>

{
  "name": "vcall",
  "version": "3.7.5",
  "private": true,
  "type": "module",
  "description": "Salas de vídeo P2P criptografadas fim a fim, com canvas colaborativo infinito, painel de chamadas ativas e aplicativo desktop.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vendor": "node scripts/vendor.mjs",
    "check": "node --check server.js && node scripts/features-test.mjs && node scripts/host-test.mjs && node scripts/security-test.mjs && node scripts/fixes-test.mjs && node scripts/check.mjs",
    "test": "node scripts/check.mjs && node scripts/fixes-test.mjs && node scripts/e2e.mjs && node scripts/ui-test.mjs && node scripts/proxy-test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "desktop": "electron desktop/main.js",
    "desktop:dev": "NODE_ENV=development electron desktop/main.js",
    "desktop:build": "electron-builder --config electron-builder.yml",
    "desktop:build:win": "electron-builder --config electron-builder.yml --win",
    "desktop:build:mac": "electron-builder --config electron-builder.yml --mac",
    "desktop:build:linux": "electron-builder --config electron-builder.yml --linux",
    "icons": "node scripts/icons.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "build:exe:linux": "node scripts/build-exe.mjs --linux",
    "build:setup": "node scripts/build-exe.mjs && node scripts/build-installer.mjs",
    "test:fixes": "node scripts/fixes-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:desktop": "node scripts/desktop-test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.0.0",
    "@dicebear/core": "^9.0.0",
    "@huggingface/transformers": "^4.3.0",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@ricky0123/vad-web": "^0.0.31",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "lucide-static": "^1.47.0",
    "playwright": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "vosk-browser": "^0.0.8"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/victor-kauan-coder",
  "author": "Victor Kauan <victor.kufpi@gmail.com> (https://github.com/victor-kauan-coder)"
}

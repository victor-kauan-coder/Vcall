# --- básico ---
PORT=3000
MAX_PEERS=16
LOG_LEVEL=info

# --- TURN ---
# Sem TURN, chamadas em redes corporativas e em CGNAT de operadora móvel não
# conectam. Escolha UM dos modos abaixo. Guia completo em TURN.md.

# Modo A — provedor por REST. GRÁTIS no Metered Open Relay (20 GB/mês).
# Serve também para Xirsys, Twilio e afins.
# TURN_API_URL=https://SEUAPP.metered.live/api/v1/turn/credentials?apiKey=SUA_CHAVE
# TURN_API_TOKEN=
# TURN_API_METHOD=GET

# Modo B — coturn próprio com segredo compartilhado (RECOMENDADO).
# De graça no Oracle Cloud Always Free: 10 TB de saída por mês, São Paulo.
# O mesmo valor de static-auth-secret no turnserver.conf. O servidor gera
# credenciais temporárias; o segredo nunca chega ao navegador.
# TURN_URLS=turn:turn.seudominio.com.br:3478?transport=udp,turn:turn.seudominio.com.br:3478?transport=tcp,turns:turn.seudominio.com.br:5349?transport=tcp
# TURN_SECRET=
# TURN_TTL=21600

# Modo C — Cloudflare Realtime (pago, US$ 0,05/GB)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

# Modo D — usuário e senha fixos (só para testar)
# O /ice é público: esta senha fica visível para qualquer visitante.
# TURN_URLS=turn:turn.seudominio.com.br:3478
# TURN_USER=
# TURN_PASS=

# --- diagnóstico ---
# "relay" força TODO o tráfego pelo TURN — use para conferir se ele funciona
# ICE_TRANSPORT_POLICY=all
# STUN_URLS=stun:stun.l.google.com:19302

# ---------------------------------------------------------------- #
# Segurança
# ---------------------------------------------------------------- #

# Origens aceitas no WebSocket, separadas por vírgula. Vazio (padrão) aceita
# só a origem que serviu a página — cobre localhost, rede local e túnel sem
# configurar nada. Preencha apenas se o app for servido de um domínio
# diferente do que abre o WebSocket.
# ALLOWED_ORIGINS=https://vcall.seudominio.com.br

# Sockets simultâneos por endereço IP. Uma pessoa abre 2 ou 3 abas, não 40.
# Atrás de um proxy que não repasse o IP real, todos parecem o mesmo endereço:
# nesse caso, ligue TRUST_PROXY=1 ou aumente este número.
#
# Servidor publicado com `cloudflared tunnel` na MESMA máquina: ligue esta
# opção para que cada visitante seja contado pelo endereço real (cabeçalho
# CF-Connecting-IP), e não como 127.0.0.1. NÃO ligue atrás de outro proxy
# local (nginx, Caddy): lá o cabeçalho poderia ser forjado.
# TRUST_CLOUDFLARE=1
# MAX_SOCKETS_PER_IP=24

# Mensagens de sinalização por janela, por conexão. O excedente é descartado;
# só um abuso muito acima disso encerra a conexão.
# RATE_BURST=240
# RATE_WINDOW_MS=10000
